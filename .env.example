# Arquivo de Configuração de Ambiente
# Copie este arquivo como .env e preencha com seus dados

# ========== GMAIL CONFIGURATION ==========
# Para ativar envio de emails via Gmail
# Veja: SETUP_EMAIL_GMAIL.md

GMAIL_USER=seuEmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ========== SENDGRID CONFIGURATION (Alternativa) ==========
# Se preferir usar SendGrid em vez de Gmail
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@seu-dominio.com

# ========== SERVER CONFIGURATION ==========
NODE_ENV=production
PORT=3000

# ========== FIREBASE (Já configurado no frontend) ==========
# Dados do Firebase - veja index.html firebaseConfig
FIREBASE_PROJECT_ID=cash-control-ef893
FIREBASE_PRIVATE_KEY_ID=sua-chave-privada
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_DATABASE_URL=https://cash-control-ef893.firebaseio.com

# ========== DESENVOLVIMENTO ==========
DEBUG=false
API_BASE_URL=http://localhost:3000

# ========== NÃO ESQUEÇA! ==========
# 1. Adicione .env ao .gitignore
# 2. NUNCA faça commit deste arquivo
# 3. Use variáveis de ambiente em produção
# 4. Reinicie o servidor após mudar valores
